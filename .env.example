# Copy to .env for local work. Never commit .env.
# Netlify env vars are set in the Netlify UI, not from this file.

# Google Analytics 4 — create a NEW property for willametteweb.com.
# Do not reuse the Baseline Studio property; the domain and business changed.
GA4_MEASUREMENT_ID=

# Where the contact form delivers. Until this is wired, the form must not
# pretend to submit (handbook launch checklist: "a lead lands in an inbox").
CONTACT_FORM_ENDPOINT=

# --- The 30-Day Program application (netlify/functions/application-*.js) -----
# Used ONLY by the Netlify Functions, server-side. They never reach the browser.
# See docs/APPLICATION-SETUP.md.

# The Supabase project URL, e.g. https://abcdefgh.supabase.co
# This is the SAME project as the referral program: one database, one source of
# truth for a lead that becomes a client.
SUPABASE_URL=

# The Supabase SERVICE ROLE key. SECRET — it bypasses Row Level Security.
# In Netlify, tick "Contains secret values". Never put it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Set to "off" to disable the Netlify Forms backup capture (on by default; it
# is what produces the email alert for every application).
# APPLICATION_FORMS_MIRROR=
