# Copy to .env for local work. Never commit .env.
# Netlify env vars are set in the Netlify UI, not from this file.

# Google Analytics 4 — create a NEW property for willametteweb.com.
# Do not reuse the Baseline Studio property; the domain and business changed.
GA4_MEASUREMENT_ID=

# Where the contact form delivers. Until this is wired, the form must not
# pretend to submit (handbook launch checklist: "a lead lands in an inbox").
CONTACT_FORM_ENDPOINT=
