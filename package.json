{
  "name": "willamette-web-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Willamette Web Design — marketing site. Static HTML, no build step, deployed on Netlify.",
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "audit:json": "node scripts/audit.mjs --json",
    "images": "node scripts/optimize-images.mjs",
    "css": "node scripts/inline-css.mjs",
    "css:check": "node scripts/inline-css.mjs --check",
    "sitemap": "node scripts/build-sitemap.mjs",
    "serve": "npx --yes http-server . -p 8080 -c-1",
    "preflight": "npm run css:check && npm run sitemap && npm run audit"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  }
}
